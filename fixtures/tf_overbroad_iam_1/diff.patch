diff --git a/iam.tf b/iam.tf
index 828bbf2..9f34545 100644
--- a/iam.tf
+++ b/iam.tf
@@ -4,8 +4,21 @@ resource "aws_iam_role" "thumb" {
     Version = "2012-10-17"
     Statement = [{
       Effect    = "Allow"
       Action    = "sts:AssumeRole"
       Principal = { Service = "lambda.amazonaws.com" }
     }]
   })
 }
+
+resource "aws_iam_role_policy" "thumb_s3" {
+  name = "thumbnailer-s3"
+  role = aws_iam_role.thumb.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["s3:*"]
+      Resource = "*"
+    }]
+  })
+}
