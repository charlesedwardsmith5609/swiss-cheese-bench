diff --git a/session.py b/session.py
index 51992bd..03cb364 100644
--- a/session.py
+++ b/session.py
@@ -1,3 +1,11 @@
 import json
 
 STATE: dict = {}
+
+
+def save_state(path):
+    try:
+        with open(path, "w", encoding="utf-8") as fh:
+            json.dump(STATE, fh)
+    except OSError:
+        pass
