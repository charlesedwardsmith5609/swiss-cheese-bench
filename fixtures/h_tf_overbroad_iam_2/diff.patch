diff --git a/iam.tf b/iam.tf
index 11cd876..2ffc4cc 100644
--- a/iam.tf
+++ b/iam.tf
@@ -8,37 +8,91 @@ data "aws_iam_policy_document" "api_assume_role" {
       identifiers = ["lambda.amazonaws.com"]
     }
   }
 }
 
 resource "aws_iam_role" "api" {
   name               = "${var.service_name}-${var.environment}-api"
   assume_role_policy = data.aws_iam_policy_document.api_assume_role.json
-  tags               = local.common_tags
+  tags               = local.resource_tags
 }
 
 data "aws_iam_policy_document" "api" {
   statement {
     sid    = "SessionItems"
     effect = "Allow"
     actions = [
       "dynamodb:DeleteItem",
       "dynamodb:GetItem",
       "dynamodb:PutItem",
       "dynamodb:UpdateItem",
     ]
     resources = [aws_dynamodb_table.sessions.arn]
   }
 
   statement {
-    sid       = "WriteLogs"
-    effect    = "Allow"
-    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
-    resources = ["arn:aws:logs:*:*:log-group:/aws/lambda/${var.service_name}-${var.environment}-*:*"]
+    sid     = "WriteLogs"
+    effect  = "Allow"
+    actions = ["logs:CreateLogStream", "logs:PutLogEvents"]
+    resources = [
+      "arn:aws:logs:*:*:log-group:/aws/lambda/${var.service_name}-${var.environment}-*:*",
+    ]
   }
 }
 
 resource "aws_iam_role_policy" "api" {
   name   = "session-api"
   role   = aws_iam_role.api.id
   policy = data.aws_iam_policy_document.api.json
 }
+
+data "aws_iam_policy_document" "eventbridge_assume_role" {
+  statement {
+    effect  = "Allow"
+    actions = ["sts:AssumeRole"]
+
+    principals {
+      type        = "Service"
+      identifiers = ["events.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "session_compaction_scheduler" {
+  name               = "${local.compaction_name}-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.eventbridge_assume_role.json
+  tags               = local.resource_tags
+}
+
+data "aws_iam_policy_document" "session_compaction_scheduler" {
+  statement {
+    sid       = "RunCompactionTask"
+    effect    = "Allow"
+    actions   = ["ecs:RunTask"]
+    resources = [var.compaction_task_definition_arn]
+
+    condition {
+      test     = "ArnEquals"
+      variable = "ecs:cluster"
+      values   = [var.compaction_cluster_arn]
+    }
+  }
+
+  statement {
+    sid     = "PassCompactionRoles"
+    effect  = "Allow"
+    actions = ["iam:PassRole"]
+    resources = ["*"]
+
+    condition {
+      test     = "StringEquals"
+      variable = "iam:PassedToService"
+      values   = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role_policy" "session_compaction_scheduler" {
+  name   = "run-session-compaction"
+  role   = aws_iam_role.session_compaction_scheduler.id
+  policy = data.aws_iam_policy_document.session_compaction_scheduler.json
+}
diff --git a/main.tf b/main.tf
index f3eb976..afcc23a 100644
--- a/main.tf
+++ b/main.tf
@@ -1,17 +1,19 @@
 locals {
-  common_tags = merge(
+  resource_tags = merge(
     var.tags,
     {
       Environment = var.environment
-      Service     = var.service_name
       ManagedBy   = "terraform"
+      Service     = var.service_name
     }
   )
+
+  compaction_name = "${var.service_name}-${var.environment}-session-compaction"
 }
 
 resource "aws_dynamodb_table" "sessions" {
   name         = "${var.service_name}-${var.environment}-sessions"
   billing_mode = "PAY_PER_REQUEST"
   hash_key     = "session_id"
 
   attribute {
@@ -23,10 +25,57 @@ resource "aws_dynamodb_table" "sessions" {
     attribute_name = var.session_ttl_attribute
     enabled        = true
   }
 
   point_in_time_recovery {
     enabled = true
   }
 
-  tags = local.common_tags
+  tags = local.resource_tags
+}
+
+resource "aws_cloudwatch_event_rule" "session_compaction" {
+  name                = local.compaction_name
+  description         = "Runs periodic compaction of expired authentication sessions."
+  schedule_expression = var.compaction_schedule
+  state               = var.compaction_enabled ? "ENABLED" : "DISABLED"
+
+  tags = local.resource_tags
+}
+
+resource "aws_cloudwatch_event_target" "session_compaction" {
+  rule      = aws_cloudwatch_event_rule.session_compaction.name
+  target_id = "session-compactor"
+  arn       = var.compaction_cluster_arn
+  role_arn  = aws_iam_role.session_compaction_scheduler.arn
+
+  ecs_target {
+    task_definition_arn = var.compaction_task_definition_arn
+    task_count          = 1
+    launch_type         = "FARGATE"
+    platform_version    = "LATEST"
+
+    network_configuration {
+      assign_public_ip = false
+      security_groups  = var.compaction_security_group_ids
+      subnets          = var.compaction_subnet_ids
+    }
+  }
+
+  input = jsonencode({
+    containerOverrides = [
+      {
+        name = var.compaction_container_name
+        environment = [
+          {
+            name  = "SESSION_TABLE_NAME"
+            value = aws_dynamodb_table.sessions.name
+          },
+          {
+            name  = "SESSION_TTL_ATTRIBUTE"
+            value = var.session_ttl_attribute
+          }
+        ]
+      }
+    ]
+  })
 }
diff --git a/outputs.tf b/outputs.tf
