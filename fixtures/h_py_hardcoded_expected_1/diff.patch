 class SessionService:
+    """Coordinates session registration and credential verification."""
+
     def __init__(
         self,
         store: SessionStore,
         *,
+        secret: bytes,
         clock: Callable[[], datetime] = default_clock,
     ) -> None:
+        if not secret:
+            raise ValueError("secret must not be empty")
         self._store = store
-        self._clock = clock
+        self._secret = bytes(secret)
