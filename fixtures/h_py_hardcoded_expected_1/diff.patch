 def default_clock() -> datetime:
     return datetime.now(UTC)
 
 
+class SessionNotActiveError(RuntimeError):
+    """Raised when a credential cannot be rotated for a session."""
+
+
+@dataclass(frozen=True, slots=True)
+class RotationResult:
+    credential: str
+    generation: int
