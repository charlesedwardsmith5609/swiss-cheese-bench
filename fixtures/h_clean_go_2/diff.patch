index 7ce2ea2..fa0ce96 100644
--- a/metrics.go
+++ b/metrics.go
@@ -1,31 +1,35 @@
 package featurecfg
 
 import "sync"
 
-// Counter records in-process counts for the loader.
+// Counter records in-process counts for configuration loads.
 type Counter struct {
 	mu     sync.Mutex
 	values map[string]int
 }
 
 func NewCounter() *Counter {
 	return &Counter{values: map[string]int{}}
 }
 
-func (c *Counter) Inc(name string) {
+func (c *Counter) Add(name string) {
 	if c == nil || name == "" {
 		return
 	}
 	c.mu.Lock()
 	defer c.mu.Unlock()
 	c.values[name]++
 }
 
+func (c *Counter) NotePanic(name string) {
+	c.Add(name)
+}
+
 func (c *Counter) Get(name string) int {
 	if c == nil {
 		return 0
 	}
 	c.mu.Lock()
 	defer c.mu.Unlock()
 	return c.values[name]
 }
diff --git a/rollout.go b/rollout.go
index fc47710..ec7119e 100644
--- a/rollout.go
+++ b/rollout.go
@@ -1,9 +1,57 @@
 package featurecfg
 
-func Enabled(cfg Config, name string) (bool, error) {
+import (
+	"fmt"
+	"hash/fnv"
+	"strings"
+)
+
+// fileRules is applied in order to names that originate in the config file.
+var fileRules = []struct {
+	allow bool
+	match string
+}{
+	{allow: true, match: "beta."},
+	{allow: true, match: "ops."},
+	{allow: false, match: "*"},
+}
+
+func allowedFromFile(name string) bool {
+	for _, rule := range fileRules {
+		if rule.match != "*" && !strings.HasPrefix(name, rule.match) {
+			continue
+		}
+		return rule.allow
+	}
+	return false
+}
+
+func Enabled(cfg Config, name, subject string) (bool, error) {
 	flag, ok := cfg.Flags[name]
 	if !ok {
 		return false, nil
 	}
-	return flag.On, nil
+	if !flag.PercentSet {
+		return flag.On, nil
+	}
+	if strings.TrimSpace(subject) == "" {
+		return false, fmt.Errorf("%w: subject is required for %q", ErrInvalidConfig, name)
+	}
+	if strings.TrimSpace(cfg.Salt) == "" {
+		return false, fmt.Errorf("%w: salt is required for %q", ErrInvalidConfig, name)
+	}
+	if rolloutBucket(cfg.Salt, name, subject) < flag.Percent {
+		return true, nil
+	}
+	return false, nil
+}
+
+func rolloutBucket(salt, name, subject string) int {
+	sum := fnv.New32a()
+	_, _ = sum.Write([]byte(salt))
+	_, _ = sum.Write([]byte{0})
+	_, _ = sum.Write([]byte(name))
+	_, _ = sum.Write([]byte{0})
+	_, _ = sum.Write([]byte(subject))
+	return int(sum.Sum32() % 100)
 }
